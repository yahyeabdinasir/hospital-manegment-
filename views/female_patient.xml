<?xml version="1.0" encoding="UTF-8"?>


<odoo>


    <record id="female_action_patient" model="ir.actions.act_window">
        <field name="name">Female Patients</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">tree,form</field>
          <field name="context">{'default_gender':'female','default_age':'20'}</field>
        <field name="domain">[('gender', '=' ,'female')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new female patient
            </p>
        </field>
    </record>

    <menuitem
            id="female_patient"
            name=" Female Patient "
            action="female_action_patient"
            parent="patient_menu_master"

            sequence="0"/>


</odoo>

