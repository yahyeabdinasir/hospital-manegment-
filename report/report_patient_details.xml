<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_patient_details_temeplate">
        <t t-call="web.external_layout">  <!-- so this we can just use two ways we can put inside of the main  page that means just print each record to the depependent document -->
            <!-- No external layout, only your custom structure -->
                        <t t-foreach="docs" t-as="o" t-foreach-index="line_index">

            <main>


                <!-- Header Box -->
                <div class="col-md-6">
                    <table style="width:243pt; height:153pt; border:1pt solid black;
                                      border-collapse:separate; border-radius:8pt; margin:5pt;">
                        <tr>

                            <td style="width:33%;" valign="center">
                                <table style="width:77pt; height:150pt;">
                                    <tr style="height:100%;">
                                        <td align="center" valign="center">
                                            <img t-if="not o.image"
                                                 width="120" height="150"
                                                 t-attf-src="'/web/static/src/img/user_placeholder.jpg'"

                                                 class="o_object_fit_cover mr-0"
                                            />
                                            <img t-if="o.image"
                                                 t-att-src="'data:image/png;base64,%s' % to_text(o.image)"
                                                 style="max-height:45pt;max-width:90%" alt="Company Logo"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>

                            <td style="width:67%;" valign="center">
                                <table style="width:155pt; height:85pt;">


                                    <tr calss="text-center ">
                                        <td colspan="3" class="text-center">
                                            <span t-field="o.name"/>
                                        </td>

                                    </tr>

                                    <tr>
                                        <td>
                                            <span>age</span>

                                        </td>


                                        <td>
                                            <span>:</span>
                                        </td>
                                        <td>

                                            <div align="center" style="font-size:15pt;">
                                                <t t-esc="o.name"/>
                                            </div>

                                        </td>


                                    </tr>

                                    <tr>
                                        <td>
                                            <span>patient id</span>
                                        </td>
                                        <td>
                                            <span>:</span>
                                        </td>
                                        <td align="center" style="font-size:10pt;">
                                            <t t-esc="o.id"/>

                                        </td>
                                    </tr>

                                </table>
<!--                                <div>-->
<!--                                      <img t-att-src="'/report/barcode/QR/'+o.name" style="width:220px;height:75px" alt="Barcode"/>-->
<!--                                </div>-->
                                <div>
                                  <span t-field="o.name" t-options="{'widget': 'barcode', 'width': 400, 'height': 80}"/>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>


                <div class="page">

                    <h2 class="text-center">
                        <strong>Patient Details</strong>
                    </h2>

                    <table class="table table-sm">


                        <tr>
                            <th name="th_sl_no" class="text-left">
                                <span>SNO:</span>
                            </th>
                            <th style="border: 1px solid black;">Name</th>
                            <th style="border: 1px solid black;">Age</th>
                            <th style="border: 1px solid black;">Gender</th>
                            <th style="border: 1px solid black;">Phone</th>

                        </tr>


                        <tbody>
<!--                            <t t-foreach="docs" t-as="o">-->
                                <tr>
                                    <td>


                                    </td>


                                    <td style="border: 1px solid black;">
                                        <t t-esc="o.name"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="o.age"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="o.age"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="o.phone"/>
                                    </td>
                                </tr>
<!--                            </t>-->
                        </tbody>

                    </table>

                </div>


            </main>

        </t>
                </t>

    </template>
</odoo>
